# ============================
# Unified Observability Platform
# Environment Variables
# ============================
# Copy this file to .env: cp .env.example .env
# Generate keys before first run (see README.md)

# ---------- Airflow ----------
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:Niraj%4031@postgres:5432/airflow
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:Niraj%4031@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__WEBSERVER__SECRET_KEY=your-webserver-secret-key-here
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=Niraj@31
AIRFLOW_UID=50000

# ---------- Postgres ----------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=Niraj@31
POSTGRES_DB=airflow

# ---------- Elasticsearch ----------
ES_JAVA_OPTS=-Xms512m -Xmx512m

# ---------- Logstash ----------
LS_JAVA_OPTS=-Xms256m -Xmx512m

# ---------- Grafana ----------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=Niraj@31

# ---------- Kafka ----------
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
